# Written by deploy.sh for the Docker/VPS deployment. Copy to .env if configuring by hand.
# (Not used by the Cloudflare deployment — see README.)

# Domain and TLS
DOMAIN=vchat.example.com
ACME_EMAIL='you@example.com'

# Shared secret between the signaling server and coturn (generate: openssl rand -hex 32)
TURN_SECRET=

# Signs invite links and owner sessions (generate: openssl rand -hex 32). Keep it stable:
# changing it invalidates every invite link you've sent.
SECRET_KEY=

# Owner password for https://DOMAIN/admin (10+ characters). Single quotes stop '$' being
# expanded; no ' or \ inside. If it's empty or short, the server reports a configuration error
# instead of running open (SECRET_KEY being set already rules out open mode).
ADMIN_PASSWORD=''

# Optional: owner signs in with Cloudflare Access instead (behind a Cloudflare Tunnel).
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
