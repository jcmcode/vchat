# Written by deploy.sh for the Docker/VPS deployment. Copy to .env if configuring by hand.
# (Not used by the Cloudflare deployment — see README.)

# Domain and TLS
DOMAIN=vchat.example.com
ACME_EMAIL='you@example.com'

# Relay over TLS on port 443 (turns:), for networks that only allow HTTPS. A hostname of its own,
# other than DOMAIN, with a DNS A record pointing at this server (DNS only, not proxied through a
# CDN). Empty: off.
TURN_TLS_DOMAIN=turn.vchat.example.com
# Where Caddy hands those connections to coturn: the address on this server that outside traffic to
# port 3478 arrives at (the public IP if it's on an interface, else the private one behind 1:1 NAT).
# deploy.sh detects it; empty means DOMAIN:3478.
TURN_TLS_UPSTREAM=

# Shared secret between the signaling server and coturn (generate: openssl rand -hex 32)
TURN_SECRET=

# Signs invite links and owner sessions (generate: openssl rand -hex 32). Keep it stable:
# changing it invalidates every invite link you've sent.
SECRET_KEY=

# Owner password for https://DOMAIN/admin (10+ characters). Single quotes stop '$' being
# expanded; no ' or \ inside. If it's empty or short, the server reports a configuration error
# instead of running open (SECRET_KEY being set already rules out open mode).
ADMIN_PASSWORD=''

# Optional: email (https://resend.com). With RESEND_API_KEY + EMAIL_FROM the owner can email
# invites; adding OWNER_EMAIL makes the owner sign in with an emailed code instead of the password.
# RESEND_API_KEY=
# EMAIL_FROM='vchat <invites@example.com>'
# OWNER_EMAIL=you@example.com

# Optional: owner signs in with Cloudflare Access instead (behind a Cloudflare Tunnel).
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=
