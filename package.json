{
  "name": "vchat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @vchat/web --filter @vchat/signaling-server dev",
    "dev:web": "pnpm --filter @vchat/web dev",
    "dev:signal": "pnpm --filter @vchat/signaling-server dev",
    "build": "pnpm --filter @vchat/signaling-server --filter @vchat/web build",
    "build:web": "pnpm --filter @vchat/web build",
    "build:signal": "pnpm --filter @vchat/signaling-server build",
    "test": "pnpm --filter @vchat/signaling-server --filter @vchat/web test",
    "check": "pnpm --filter @vchat/signaling-server typecheck && pnpm --filter @vchat/web check && pnpm --filter @vchat/cloudflare typecheck",
    "cf:dev": "pnpm --filter @vchat/cloudflare dev",
    "cf:deploy": "pnpm --filter @vchat/cloudflare deploy",
    "desktop:dev": "pnpm --filter @vchat/desktop dev",
    "desktop:build": "pnpm --filter @vchat/desktop build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
