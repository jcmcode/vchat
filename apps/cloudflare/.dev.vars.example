# Copy to .dev.vars for `pnpm dev` (wrangler dev). .dev.vars is gitignored.
# In production, set these with: npx wrangler secret put <NAME>

# Optional: password-protect the site (username "vchat")
# SITE_PASSWORD=change-me

# Optional: Cloudflare Realtime TURN (dashboard → Realtime → TURN Server → Create)
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
