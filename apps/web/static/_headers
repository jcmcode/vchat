# Security headers for static files (read by Cloudflare Workers Static Assets and similar hosts).
# Content-Security-Policy is emitted by the app itself (apps/web/svelte.config.js).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self)
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin

# Pages are never kept in the browser's HTTP cache, so no copy stored under a room's address
# outlives the call. (Scripts and styles under /_app/ are content-hashed and stay cacheable.)
/
  Cache-Control: no-store
/room/*
  Cache-Control: no-store
/admin
  Cache-Control: no-store

# Content-hashed scripts and styles never change under the same name: no revalidation on reload.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The web app manifest's media type, for hosts that don't know .webmanifest.
/manifest.webmanifest
  Content-Type: application/manifest+json
