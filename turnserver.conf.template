# TURN relay (coturn) — generated by deploy.sh, do not edit directly.
#
# Calls are end-to-end encrypted (DTLS-SRTP) between browsers; this relay only forwards packets
# it cannot decrypt, for the minority of users behind strict NATs/firewalls.

# Network: plain TURN on 3478 (UDP + TCP). TLS on the relay itself is not needed for privacy
# (media is already encrypted end to end) and is disabled to avoid certificate plumbing.
listening-port=3478
external-ip=EXTERNAL_IP_PLACEHOLDER
no-tls
no-dtls

# Relay ports: kept above Linux's ephemeral range (32768-60999) to avoid bind conflicts.
min-port=61000
max-port=65535

# Authentication: short-lived credentials minted by the signaling server (GET /api/ice-servers).
# Usernames are "<expiry>:<id>". The id is the same for everyone joining one room from one address
# (and random where the server can't tell), and stays the same when asked again, so user-quota
# can't be reset by requesting more credentials.
realm=DOMAIN_PLACEHOLDER
use-auth-secret
static-auth-secret=TURN_SECRET_PLACEHOLDER

# Abuse limits
fingerprint
no-cli
no-tcp-relay
no-multicast-peers
no-loopback-peers
no-rfc5780
no-stun-backward-compatibility
# Allocations per credential / in total, bandwidth per session / in total. coturn counts
# bandwidth in BYTES per second: 500000 is 4 Mbit/s per session, 25000000 is 200 Mbit/s in total.
# A credential is shared by the people in one room behind one address (housemates, an office),
# and each of them uses up to two allocations per other participant — hence 48, not 12.
user-quota=48
total-quota=300
max-bps=500000
bps-capacity=25000000
stale-nonce=600

# Never relay to private, internal or special-purpose addresses (incl. cloud metadata and this host).
denied-peer-ip=EXTERNAL_IP_PLACEHOLDER
# Every address configured on this host (filled in by deploy.sh):
HOST_ADDRESSES_PLACEHOLDER
# Azure's platform/metadata endpoint
denied-peer-ip=168.63.129.16
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-239.255.255.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::
denied-peer-ip=::1
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
# NAT64 (64:ff9b:1::/48) and Teredo (2001::/32)
denied-peer-ip=64:ff9b:1::-64:ff9b:1:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001::-2001:0:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2001:db8::-2001:db8:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fec0::-feff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=ff00::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# Logging: off — no IP addresses or session records are kept. Without simple-log, coturn appends a
# pid/date suffix to log-file ("/dev/null_<pid>_<date>.log"), can't create it, and falls back to
# writing /var/tmp/turn_*.log.
no-stdout-log
simple-log
log-file=/dev/null
