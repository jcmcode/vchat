{
	# No logs at all. Caddy writes no access logs unless a `log` directive is added, but its default
	# logger would still print errors, and those include client IPs and request headers (such as the
	# invite token sent in Sec-WebSocket-Protocol). See DOCS.md for enabling logs while debugging.
	log default {
		output discard
	}

	# TURN over TLS on port 443 (caddy/turn-tls-on/), an opt-in add-on. docker-compose.turn-tls.yml
	# sets TURN_TLS=on and builds an image that contains that folder; these two imports then load
	# its files. Otherwise the folder name below is "turn-tls-", which doesn't exist (and the stock
	# image has no turn-tls-on folder either); because the path is a pattern (the *), it matches
	# nothing and imports nothing, and Caddy runs exactly as it would without these lines.
	import turn-tls-{$TURN_TLS}/global*.caddy
}

import turn-tls-{$TURN_TLS}/site*.caddy

{$DOMAIN} {
	tls {$ACME_EMAIL}

	# Access control is done by the app: the owner signs in at /admin, guests use invite links.

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
		Strict-Transport-Security "max-age=31536000"
		# The full Content-Security-Policy is set by the app itself (apps/web/svelte.config.js);
		# frame-ancestors only works as a header, so it's added here.
		Content-Security-Policy "frame-ancestors 'none'"
		Cross-Origin-Opener-Policy same-origin
	}

	handle /ws {
		reverse_proxy signaling:3001
	}

	handle /api/* {
		reverse_proxy signaling:3001
	}

	# Header rules for static hosts like Cloudflare; not a page.
	handle /_headers {
		respond 404
	}

	handle {
		root * /srv/web
		# Pages are never kept in the browser's HTTP cache, so no copy stored under a room's address
		# outlives the call. (Scripts and styles under /_app/ are content-hashed and stay cacheable.)
		@pages path / /room/* /admin /admin/*
		header @pages Cache-Control no-store
		# The web app manifest's media type (Caddy doesn't know .webmanifest on every system).
		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json
		try_files {path} /index.html
		file_server
	}
}
