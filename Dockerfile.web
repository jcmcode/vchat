# Caddy with the layer4 plugin, which serves TURN over TLS on port 443 next to the website (see
# caddy/turn-tls-on/). Caddy, the plugin and both Caddy images are pinned; xcaddy fetches the plugin
# through the Go module proxy, which checks it against the Go checksum database.
FROM caddy:2.11.9-builder-alpine@sha256:646fee578e680989ca5c7fd1ce6f1de574d19fd71ef2221810cc0510a9f40c86 AS caddy
RUN xcaddy build v2.11.9 --with github.com/mholt/caddy-l4@v0.1.3 \
	&& ./caddy list-modules | grep -q layer4

FROM node:24-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @vchat/web

COPY apps/web/ apps/web/
RUN pnpm --filter @vchat/web build

FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0
COPY --from=caddy /usr/bin/caddy /usr/bin/caddy
COPY Caddyfile /etc/caddy/Caddyfile
COPY caddy/turn-tls-on/ /etc/caddy/turn-tls-on/
COPY --from=builder /app/apps/web/build /srv/web
