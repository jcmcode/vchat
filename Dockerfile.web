# The web app, served by Caddy. The default target (`web`, the last stage) uses the stock Caddy
# image and compiles nothing. The `web-turn-tls` target, used only when the relay on port 443 is on
# (docker-compose.turn-tls.yml), swaps in Caddy built with the layer4 plugin.

# Caddy with the layer4 plugin (see caddy/turn-tls-on/). Caddy, the plugin and both Caddy images are
# pinned; xcaddy fetches the plugin through the Go module proxy, which checks it against the Go
# checksum database. Compiling one package at a time with a soft memory limit keeps a 1GB server
# from running out of memory.
FROM caddy:2.11.9-builder-alpine@sha256:646fee578e680989ca5c7fd1ce6f1de574d19fd71ef2221810cc0510a9f40c86 AS caddy-l4
ENV GOFLAGS=-p=1 GOMEMLIMIT=512MiB
RUN xcaddy build v2.11.9 --with github.com/mholt/caddy-l4@v0.1.3 \
	&& ./caddy list-modules | grep -q layer4

FROM node:24-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @vchat/web

COPY apps/web/ apps/web/
RUN pnpm --filter @vchat/web build

FROM caddy:2.11.9-alpine@sha256:003a97808e781aa9f7e75cc2f43d34d461099031faf5e20faefb9f61126836f0 AS web-base
COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /app/apps/web/build /srv/web

# With the relay on port 443: Caddy with layer4, and the config the Caddyfile then imports.
FROM web-base AS web-turn-tls
COPY --from=caddy-l4 /usr/bin/caddy /usr/bin/caddy
COPY caddy/turn-tls-on/ /etc/caddy/turn-tls-on/

# Default: stock Caddy. The relay-on-443 config isn't in this image, so it can never be loaded here.
FROM web-base AS web
